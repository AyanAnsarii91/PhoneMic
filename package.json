{
  "name": "phonemic-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "phone",
    "desktop"
  ],
  "scripts": {
    "build:shared": "npm run --workspace=shared build",
    "dev:phone": "npm run --workspace=phone dev",
    "build:phone": "npm run --workspace=phone build",
    "dev:desktop": "npm run --workspace=desktop dev",
    "build:desktop": "npm run --workspace=desktop build",
    "package:desktop": "npm run --workspace=desktop package",
    "test": "npx tsx scripts/test-e2e.ts",
    "start": "concurrently \"npm run dev:phone\" \"npm run dev:desktop\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}